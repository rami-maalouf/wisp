shape Microphone
  id: string
  name: string

shape Status
  available: bool
  phase: string
  microphones: Microphone[]
  selectedMic: string
  folder: string
  elapsed: string
  fileName: string
  filePath: string
  error: string
  inputLevel: string
  fileWarning: string

shape Reply
  ok: bool
  error: string

routes nav
  home "/"

component Recorder
  resource status = recorderStatus() as shape Status else empty(available=false, phase="idle", microphones=[], selectedMic="", folder="", elapsed="00:00", fileName="", filePath="", error="", inputLevel="", fileWarning="")
  mutation result as shape Reply refreshes status
  derive paused = status.phase == "paused"
  derive recording = status.phase == "recording"
  derive busy = pending(result) or status.phase == "starting" or status.phase == "stopping" or status.phase == "pausing" or status.phase == "resuming" or status.phase == "cancelling"
  derive locked = status.phase != "idle" or busy
  derive replyError = match result { case some(r) => r.error, case none => "" }
  derive error = status.error != "" ? status.error : replyError
  derive phaseLabel = status.phase == "starting" ? "Opening microphone…" : status.phase == "stopping" ? "Saving recording…" : status.phase == "cancelling" ? "Cancelling recording…" : paused ? "Paused" : recording ? "Recording" : "Ready to record"
  action chooseMic(id: string)
    send result = selectMicrophone(id)
  action refresh
    send result = refreshMicrophones()
  action folder
    send result = chooseFolder()
  action start
    send result = startRecording()
  action togglePause
    if paused
      send result = resumeRecording()
    else
      send result = pauseRecording()
  action stop
    send result = stopRecording()
  action cancel
    send result = cancelRecording()
  action reveal
    send result = revealRecording()
  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            h1 "Exact Recorder" flex=1
          scroll id="content" flex=1 min-height=0
            column padding=28 gap=24 max-width=520 margin="0 auto" box-sizing="border-box"
              column gap=8 align-items="center" padding="16px 0"
                image "symbol:waveform" width=32 height=32 color=(recording ? "-exact-system-red" : "-exact-secondary-label")
                text status.elapsed font-size=56 font-weight=300 font-variant-numeric="tabular-nums" testId="elapsed"
                text phaseLabel color=(recording ? "-exact-system-red" : "-exact-secondary-label") testId="phase"
                if recording
                  text status.inputLevel font="-exact-footnote" color="-exact-secondary-label" testId="input-level"
              column gap=10
                row align-items="center" gap=12
                  text "Microphone" font-weight=600 flex=1
                  button press=refresh disabled=locked aria-label="Refresh microphones" testId="refresh"
                    image "symbol:refresh"
                select value=status.selectedMic change=chooseMic disabled=(locked or not status.available) aria-label="Microphone" testId="microphone" width="100%"
                  if status.microphones.length == 0
                    option "No microphone found" value=""
                  for mic in status.microphones key=mic.id
                    option mic.name value=mic.id
              column gap=10
                row align-items="center" gap=12
                  text "Save to" font-weight=600 flex=1
                  button press=folder disabled=(locked or not status.available) testId="choose-folder" buttonStyle="bordered"
                    text "Choose Folder…"
                text (status.folder == "" ? "Open the macOS app to choose a folder." : status.folder) color="-exact-secondary-label" font="-exact-footnote" overflow-wrap="anywhere" testId="folder"
              row gap=12 justify-content="center"
                button press=start disabled=(locked or not status.available or status.selectedMic == "") buttonStyle="filled" testId="start"
                  text "Start Recording"
                button press=togglePause disabled=((not recording and not paused) or busy) buttonStyle="bordered" testId="pause"
                  text (paused ? "Resume" : "Pause")
                button press=stop disabled=((not recording and not paused) or busy) buttonStyle="bordered" testId="stop"
                  text "Stop"
              if locked
                row justify-content="center"
                  button press=cancel disabled=((not recording and not paused) or busy) testId="cancel" aria-label="Cancel and discard recording"
                    text "Cancel Recording"
              if error != ""
                text error color="-exact-system-red" role="alert" overflow-wrap="anywhere" testId="error"
              if status.filePath != ""
                column gap=8 padding=16 border-radius=12 background-color="-exact-secondary-background" testId="saved"
                  text (status.fileWarning == "" ? "Recording saved" : "Recording file kept - check the warning") font-weight=600
                  if status.fileWarning != ""
                    text status.fileWarning color="-exact-system-red" font="-exact-footnote" overflow-wrap="anywhere"
                  text status.fileName font="-exact-footnote" overflow-wrap="anywhere" testId="saved-name"
                  button press=reveal disabled=busy testId="reveal"
                    text "Show in Finder"
              text "For full-quality Bluetooth headphone playback, use your Mac or a USB microphone." font="-exact-footnote" color="-exact-secondary-label" text-align="center"
              text "Uncompressed WAV audio. Your microphone and folder are remembered." font="-exact-footnote" color="-exact-secondary-label" text-align="center"
