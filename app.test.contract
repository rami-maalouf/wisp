test "select a microphone and folder, save recordings, and trash the last file"
  size 520x650
  expect text "phase" == "Ready to record"
  expect tree missing "stop"
  expect enabled "start"
  type "microphone" "test-usb"
  clock data
  expect state status.selectedMic == "test-usb"
  tap "choose-folder"
  clock data
  tap "start"
  clock data
  expect text "phase" == "Recording"
  expect tree missing "start"
  expect disabled "microphone"
  expect disabled "choose-folder"
  expect enabled "stop"
  clock +3000
  expect text "elapsed" == "00:03"
  tap "pause"
  clock data
  expect text "phase" == "Paused"
  expect text "pause" == "Resume"
  clock +5000
  expect text "elapsed" == "00:03"
  tap "pause"
  clock data
  expect text "phase" == "Recording"
  clock +2000
  expect text "elapsed" == "00:05"
  tap "stop"
  clock data
  expect text "phase" == "Ready to record"
  expect tree has "saved"
  expect tree missing "error"
  expect state status.recents.length == 1
  expect enabled "start"
  expect tree missing "stop"
  tap "start"
  clock data
  clock +1000
  tap "pause"
  clock data
  tap "stop"
  clock data
  expect tree has "saved"
  expect tree missing "error"
  expect state status.recents.length == 2

  tap "trash"
  clock data
  expect tree missing "saved"
  expect state status.filePath == ""
  expect state status.fileWarning == ""
  expect tree missing "error"
  expect enabled "start"
  expect state status.recents.length == 1
  tap "recent-reveal-0"
  clock data
  expect tree missing "error"
  expect state status.recents.length == 1
  tap "recent-trash-0"
  clock data
  expect state status.recents.length == 0
  expect tree has "recents-empty"

test "recents follow the selected folder and deleting the newest clears the saved card"
  size 380x540
  tap "start"
  clock data
  clock +1000
  tap "stop"
  clock data
  expect state status.recents.length == 1
  tap "refresh-recents"
  clock data
  expect state status.recents.length == 1
  tap "recent-trash-0"
  clock data
  expect state status.recents.length == 0
  expect tree missing "saved"
  expect tree missing "error"
  tap "start"
  clock data
  clock +1000
  tap "stop"
  clock data
  expect state status.recents.length == 1
  tap "choose-folder"
  clock data
  expect state status.recents.length == 0
  expect tree missing "saved"
  expect tree missing "error"
  expect tree has "recents-empty"

test "deleting one recent preserves other files"
  size 440x600
  tap "start"
  clock data
  clock +1000
  tap "stop"
  clock data
  tap "start"
  clock data
  clock +1000
  tap "stop"
  clock data
  tap "start"
  clock data
  clock +1000
  tap "stop"
  clock data
  expect state status.recents.length == 3
  tap "recent-trash-1"
  clock data
  expect state status.recents.length == 2
  expect tree has "saved"
  expect tree missing "error"
  tap "recent-trash-0"
  clock data
  expect state status.recents.length == 1
  expect tree missing "saved"
  expect tree missing "error"

test "refresh microphones and display the idle screen"
  size 400x540
  tap "refresh"
  clock data
  expect state status.selectedMic == "test-mic"
  expect text "elapsed" == "00:00"
  expect tree missing "saved"
  expect tree missing "error"
  tap "open-folder"
  clock data
  expect tree missing "error"
  expect tree has "recents-empty"

test "cancel active and paused recordings without saving, then record again"
  size 400x540
  tap "start"
  clock data
  clock +2000
  tap "cancel"
  clock data
  expect text "phase" == "Ready to record"
  expect text "elapsed" == "00:00"
  expect tree missing "saved"
  expect tree missing "error"
  expect enabled "start"
  tap "start"
  clock data
  clock +1000
  tap "pause"
  clock data
  expect enabled "cancel"
  tap "cancel"
  clock data
  expect text "elapsed" == "00:00"
  expect tree missing "saved"
  expect tree missing "error"
  tap "start"
  clock data
  clock +1000
  tap "stop"
  clock data
  expect tree has "saved"
  expect tree missing "error"
